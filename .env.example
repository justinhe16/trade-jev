# Copy to .env (gitignored) and fill in. Never commit .env.

# --- Jev (TypeSafe) ---
TYPESAFE_API_KEY=

# --- feed: databento | tradovate | off (off = skip every day: a `skipped` row, exit 0) ---
TRADE_JEV_SOURCE=databento

# --- Databento (TRADE_JEV_SOURCE=databento; needs a live L2 licence) ---
DATABENTO_API_KEY=

# --- Tradovate TOKEN MODE (My Funded Futures simulated account; the API password login is refused) ---
# Log in on https://trader.tradovate.com, open the browser dev tools > Network, find the
# `accesstokenrequest` response and copy `accessToken` and `mdAccessToken` here. Close the tab, do NOT
# log out of the web app (that kills the tokens). With these set (or data/tradovate_token.json present),
# the five password variables below are not needed. The keep-alive (com.tradejev.tvtoken) renews them
# about every 50 minutes; tokens die if renewal stops for more than ~80 minutes. Pasting fresh tokens
# here later is picked up automatically (the file is re-read). Never commit this file.
TRADOVATE_ACCESS_TOKEN=
TRADOVATE_MD_ACCESS_TOKEN=
# REST host for token mode (default live.tradovateapi.com: the web app logs in there, even for demo accounts)
# TRADOVATE_AUTH_HOST=live.tradovateapi.com

# --- Tradovate password mode (TRADE_JEV_SOURCE=tradovate, no tokens above): all five must be set, else the day is skipped ---
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# API key from the Tradovate web app: Settings > API Access (needs an API Access subscription)
TRADOVATE_CID=
TRADOVATE_SEC=
# any stable UUID for this machine: uuidgen
TRADOVATE_DEVICE_ID=

# demo is the recommended value for a simulated / evaluation account (REST on demo.tradovateapi.com).
# Default when unset: live.
TRADOVATE_ENV=demo
# optional
TRADOVATE_APP_ID=trade-jev
TRADOVATE_APP_VERSION=1.0
# optional, tests / emergencies only: replaces the md websocket URL (disables the host fallback)
# TRADOVATE_MD_URL=

# --- optional ---
# TRADE_JEV_DATA=
# TRADE_JEV_PAPER_DB=
