.venv/
__pycache__/
.pytest_cache/
.env

# licensed market data (see data/DATA.md); only the synthetic sample is committed
data/databento/

# local run outputs: raw Jev answers incl. the order books Jev saw
# (share with scripts/publish_run.py → results/, which is committed)
cache/
runs/*
!runs/index.jsonl

# days recorded by the live runner (licensed data)
data/live/

# executor logs (orders, fills, latencies)
runs/executor/

# private broker backends, selectors and mapping tools (local only, moved between machines by hand)
private/

# live paper trading: the paper DB (and its WAL files) and launchd logs
data/paper.db*
logs/

# Tradovate token mode: the token store, its status file, lock and temp files (secrets)
data/tradovate_token*
data/.tradovate_token*

# copy trading: the account list (account ids, limits), its SQLite DB and per-account token stores (secrets)
accounts.yaml
data/copy.db*
data/copy/
